# Telegram bot token from @BotFather
BOT_TOKEN=replace_me

# Your Telegram username, without the @. Whoever matches this and sends /start
# becomes the admin chat. Set ADMIN_CHAT_ID instead if you want to pin it hard.
ADMIN_USERNAME=yourtelegramusername
# ADMIN_CHAT_ID=123456789

# Private supergroup with forum topics enabled, where customer threads appear.
RELAY_ADMIN_GROUP_ID=-1001234567890

# How long a redemption or extension is good for.
ACCESS_DURATION_DAYS=30

# How far ahead the digest warns you about upcoming lapses.
EXPIRY_WARNING_DAYS=7
